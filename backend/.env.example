# =====================================================================
# NextMeal Backend — Environment Variables
# Copy this file to .env and fill in the values before starting.
# =====================================================================

# ----- Database -------------------------------------------------------
# SQLite (default, development):
DATABASE_URL=sqlite:///./nextmeal.db
# PostgreSQL example (production):
# DATABASE_URL=postgresql://user:password@localhost:5432/nextmeal

# ----- JWT ------------------------------------------------------------
# Generate a strong random value, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ----- CORS -----------------------------------------------------------
# The exact origin of your frontend (no trailing slash)
FRONTEND_ORIGIN=http://localhost:5173

# ----- Rate limiting --------------------------------------------------
# Format: "<count>/<period>"  period = second, minute, hour, day
RATE_LIMIT_REGISTER=5/minute
RATE_LIMIT_LOGIN=10/minute
